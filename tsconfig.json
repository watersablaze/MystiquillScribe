{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/com/app/*"],
      "@ui/*": ["packages/ui/*"],
      "@config/*": ["packages/config/*"],
      "": ["packages/lib/db"],
      "@lib/email": ["packages/lib/email"],
      "@lib/*": ["apps/com/app/lib/*"],
      "@app/*": ["apps/com/app/*"],
      "@/lib/db": ["apps/com/app/lib/db"],
      "@/lib/email": ["apps/com/app/lib/email"],
      "@/lib/*": ["apps/com/app/lib/*"],
      "@/packages/*": ["packages/*"],
      "@packages/*": ["packages/*"]
    },
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      { "name": "next" }
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "types/**/*.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
