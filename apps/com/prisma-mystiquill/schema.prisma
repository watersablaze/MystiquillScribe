generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_MYSTIQUILL")
}

//
// Enums
//
enum OfferingType {
  FIRE
  WATER
  CIRCLE
}

enum ContributionTier {
  KINDLING
  STEADY_FLAME
  BONFIRE
  DROP
  STREAM
  OCEAN
}

enum Role {
  USER
  ADMIN
}

//
// Core user + NextAuth
//
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  username      String?   @unique
  name          String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Domain relations
  memberships   Membership[]
  bookings      Booking[]
  contributions Contribution[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//
// Memberships / Offerings / Bookings / Contributions
//
model Membership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  tier        String
  active      Boolean   @default(true)
  startedAt   DateTime  @default(now())
  cancelledAt DateTime?
}

model Offering {
  id              String       @id @default(cuid())
  slug            String       @unique
  type            OfferingType
  title           String
  subtitle        String?
  description     String
  isActive        Boolean      @default(true)
  contributionMin Int          @default(88)
  contributionMax Int          @default(222)
  createdAt       DateTime     @default(now())

  bookings      Booking[]
  contributions Contribution[]
}

model Booking {
  id           String   @id @default(cuid())
  userId       String?
  offeringId   String
  scheduledFor DateTime
  durationMin  Int      @default(60)
  status       String   @default("PENDING")
  note         String?
  createdAt    DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id])
  offering Offering @relation(fields: [offeringId], references: [id])
}

model Contribution {
  id          String            @id @default(cuid())
  userId      String?
  offeringId  String?
  tier        ContributionTier?
  amountCents Int
  currency    String            @default("USD")
  provider    String
  providerRef String            @unique
  status      String            @default("SUCCEEDED")
  createdAt   DateTime          @default(now())

  user     User?     @relation(fields: [userId], references: [id])
  offering Offering? @relation(fields: [offeringId], references: [id])
}

//
// Content (Posts, Events)
//

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  tags        String[]  @default([])
  category    String?
  createdAt   DateTime  @default(now())
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int?
  location    String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model OdysseyEntry {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  content String

  accessType AccessType @default(OPEN)

  guidedIntro    String?
  guidedMeta     String?
  guidedTitle    String?
  guidedImageUrl String?

  heroImage   String?
  category    String?
  tags        String?
  publishedAt DateTime?

  published Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions OdysseyRevision[]
}

enum AccessType {
  OPEN
  PATRON
  GUIDED
}

model OdysseyRevision {
  id        String   @id @default(cuid())
  entryId   String
  title     String
  content   String
  excerpt   String?
  createdAt DateTime @default(now())

  entry OdysseyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model OdysseyAccess {
  id String @id @default(cuid())

  entrySlug String
  email     String
  reference String @unique

  accessType AccessType
  verified   Boolean    @default(false)

  createdAt DateTime @default(now())

  @@index([entrySlug])
  @@index([email])
}

/* 
  Mystiquill Partner Inquiries
*/

enum MystiquillPartnerType {
  CREATIVE_COLLABORATOR
  PATRON
  INSTITUTIONAL
  COMMISSION
  CONTRIBUTOR
  OTHER
}

enum MystiquillPartnerStatus {
  NEW_INQUIRY
  UNDER_REVIEW
  ALIGNED_PENDING_CLARITY
  NOT_ALIGNED
  ARCHIVED_FOR_LATER
  INVITED_TO_TRIAL
  TRIAL_ACTIVE
  TRIAL_COMPLETE
  AGREEMENT_PENDING
  ACTIVE_PARTNER
  PAUSED
  COMPLETED
  RELEASED
}

model MystiquillPartnerInquiry {
  id              String @id @default(cuid())

  name            String
  email           String
  location        String?
  website         String?
  organization    String?

  partnerType     MystiquillPartnerType
  readiness       String?

  intention       String
  alignment       String?
  offering        String?
  needs           String?

  timeline        String?
  budget          String?
  materials       String?
  peopleInvolved  String?

  scopeAgreement  Boolean @default(false)
  creditAgreement Boolean @default(false)
  trialAgreement  Boolean @default(false)

  status          MystiquillPartnerStatus @default(NEW_INQUIRY)

  internalNotes   String?
  nextAction      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([partnerType])
  @@index([status])
  @@index([createdAt])
}